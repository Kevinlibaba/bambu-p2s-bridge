{
  "pages": [
    {
      "path": "pages/monitor/index",
      "style": {
        "navigationBarTitleText": "%tab.monitor%"
      }
    },
    {
      "path": "pages/control/index",
      "style": {
        "navigationBarTitleText": "%tab.control%"
      }
    },
    {
      "path": "pages/files/index",
      "style": {
        "navigationBarTitleText": "%tab.files%"
      }
    },
    {
      "path": "pages/settings/index",
      "style": {
        "navigationBarTitleText": "%tab.settings%"
      }
    },
    {
      "path": "pages/history/index",
      "style": {
        "navigationBarTitleText": "%history.title%"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor",
    "backgroundColorContent": "@bgColor",
    "navigationBarTitleText": "Bambu P2S"
  },
  "tabBar": {
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/monitor/index",
        "text": "%tab.monitor%"
      },
      {
        "pagePath": "pages/control/index",
        "text": "%tab.control%"
      },
      {
        "pagePath": "pages/files/index",
        "text": "%tab.files%"
      },
      {
        "pagePath": "pages/settings/index",
        "text": "%tab.settings%"
      }
    ],
    "fontSize": "15px",
    "height": "56px"
  }
}
