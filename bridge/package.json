{
  "name": "bambu-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --import ./test/env.ts --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "basic-ftp": "^5.0.5",
    "fastify": "^5.2.1",
    "mqtt": "^5.10.3",
    "@fastify/static": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
