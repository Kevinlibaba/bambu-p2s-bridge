# 打印机（局域网模式 + 开发者模式）
BAMBU_HOST=192.168.1.100
BAMBU_SERIAL=XXXXXXXXXXXXXXX
BAMBU_ACCESS_CODE=xxxxxxxx

# API 鉴权 —— 用 `openssl rand -hex 24` 生成
API_TOKEN=

# 可选
PORT=8080
BIND_HOST=0.0.0.0
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_STREAM=bambu_p2s
ALLOW_RAW_GCODE=false
PUSHALL_INTERVAL_MS=300000
# 打印历史（JSONL）落盘位置，容器里挂 /data
HISTORY_PATH=/data/jobs.jsonl

# ---- 通知（可选）----
# 全部留空则不推送。任一出口配上即生效，多个出口会同时投递。
NOTIFY_ENABLED=true
# 只关心部分事件时改成逗号分隔的列表，可选值见 /api/notify 的 kinds
NOTIFY_EVENTS=all
# 错误码释义用的语言：zh-Hans / zh-Hant / en / ja
NOTIFY_LANG=zh-Hans

# Web Push：不依赖第三方，PWA 装到主屏后 iOS 也收得到。
# 用 `npx web-push generate-vapid-keys` 生成一对，公钥会下发给浏览器，私钥务必保密。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Bark（iOS）。填 https://api.day.app/<设备key>
BARK_URL=
# ntfy。填 https://ntfy.sh/<topic>，也可指向自建实例
NTFY_URL=
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 通用 webhook：原样 POST 事件 JSON，接企业微信/钉钉/自建服务都行
NOTIFY_WEBHOOK=
